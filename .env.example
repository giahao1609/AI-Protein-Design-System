# AI Protein Design System — Environment Variables
# Copy this file to .env and fill in values

# Project root (auto-detected if not set)
# PROTEIN_DESIGN_ROOT=

# Database path (default: {project_root}/protein_design.db)
# PROTEIN_DESIGN_DB=

# Log level (DEBUG, INFO, WARNING, ERROR)
PROTEIN_DESIGN_LOG_LEVEL=INFO

# Log format (json, console)
PROTEIN_DESIGN_LOG_FORMAT=console

# GPU device (for future model integration)
# CUDA_VISIBLE_DEVICES=0
